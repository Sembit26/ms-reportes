# Configuración base (DAS §5)
API_PORT=8080
API_ENV=dev
TZ=America/Santiago

# Base de datos propia (dentro de Compose apunta al servicio postgres)
POSTGRES_DB=reportes
POSTGRES_USER=reportes
POSTGRES_PASSWORD=replace-with-local-db-password
DATABASE_URL=postgres://reportes:replace-with-local-db-password@postgres:5432/reportes?sslmode=disable

# Autenticación y servicios externos
AUTH_JWKS_URL=http://replace-with-identidad:8080/.well-known/jwks.json
GESTOR_INFORMACION_URL=http://replace-with-gestor-informacion:8080
PLANTILLAS_URL=http://replace-with-plantillas:8080

# Puertos locales del servicio (Grupo 1: 5110 web y 5111 api)
HOST_WEB_PORT=5110
HOST_API_PORT=5111
FRONTEND_URL=http://localhost:5110
